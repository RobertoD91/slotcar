# DS200 ESP32 bridge — configuration.
#
# Copy this file to esp32/.env and fill in your values:
#     cp .env.example .env
#
# .env is git-ignored. These values are injected at build time as -D flags and
# OVERRIDE the defaults in include/config.h. Any line you delete/comment falls
# back to the config.h default. Strings may be quoted or not.

# ---- WiFi (leave WIFI_SSID empty to force the captive portal on first boot) --
WIFI_SSID=
WIFI_PASSWORD=

# ---- MQTT broker ------------------------------------------------------------
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_BASE_TOPIC=ds200

# ---- NTP / time -------------------------------------------------------------
NTP_SERVER_1=pool.ntp.org
NTP_SERVER_2=time.google.com
# POSIX TZ string (default Europe/Rome with DST)
TZ_INFO=CET-1CEST,M3.5.0,M10.5.0/3

# ---- DS200 serial link ------------------------------------------------------
DS200_BAUD=4800
DS200_RX_PIN=16
DS200_TX_PIN=17

# ---- Device / captive portal ------------------------------------------------
AP_NAME=DS200-Setup
AP_PASSWORD=ds200setup
HOSTNAME=ds200
WIFI_CONNECT_TIMEOUT=20
PORTAL_TIMEOUT=180
